# Local data and generated artifacts

# Raw datasets: ignore by default
data/raw/*
data/1_raw/*

# Keep directory placeholders
!data/raw/.gitkeep
!data/1_raw/.gitkeep

# Allow dataset documentation
!data/raw/hadithdb/
!data/raw/hadithdb/README.md

# Allow the Shamela narrator metadata dataset
!data/1_raw/Shamela4_Full_DB/
!data/1_raw/Shamela4_Full_DB/_meta/
!data/1_raw/Shamela4_Full_DB/_meta/narrators.parquet

# Ignore generated intermediate and processed data
data/interim/*
data/processed/*

!data/interim/.gitkeep
!data/processed/.gitkeep

# Ignore database and analytical file formats by default
*.sqlite
*.sqlite3
*.db
*.parquet
*.arrow
*.feather

# Re-allow the specific Shamela file
!data/1_raw/Shamela4_Full_DB/_meta/narrators.parquet