      "exception_id": "EXC_PROV04_COMPOUND_THIQA_AFRAAD_001",
      "rule_version": "1.0",
      "status": "proposed",
      "active": false,
      "trigger": {
        "match_type": "exact_complete_span",
        "field": "statement_text_verbatim",
        "exact_value": "ثقة له أفراد"
      },
      "scope": {
        "unit": "confirmed_statement_span",
        "interpretation_dimension": "compound_grade_qualification",
        "target_eligibility": "not_assessed",
        "requires_confirmed_candidate_identity": true,
        "requires_human_confirmed_statement_span": true,
        "requires_verified_source_text": true
      },
      "actions": ["suppress_base_match", "abstain_for_review"],
      "rationale": "The complete span is compound. A standalone ثقة rule must not match inside the longer statement and decide the full span.",
      "expected_behavior": "If a naive base matcher supplied a standalone-grade result, propose suppressing that result and sending the compound statement for human review. Do not assign a rank from this exception.",
      "supporting_pilot_refs": ["PROV-04-C01-S01"],
      "evidence_status": "pilot_pattern_only",
      "approval": {
        "status": "not_approved",
        "approved_by": null,
        "approved_on": null,
        "approval_reference": null
      }
    },
